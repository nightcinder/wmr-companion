# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
**/android/gradle-wrapper.jar
# Proprietary SDKs staged by hand or by release-unified (VITURE libglasses.so);
# never commit them. The release job deletes its copy with an always() step.
**/android/app/src/main/jniLibs/
*.keystore
*.jks

# iOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/**/xcuserdata/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Monado's config key (BSL-1.0), fetched by tool/fetch_wmr_config_key.dart
apps/wmr_companion_app/assets/monado/wmr_config_key.bin

# Unity-as-a-Library exports for the Android flavors (ONY-271). Vendor SDKs are
# not redistributable; copy unity/Build/Android/unityLibrary here to opt in.
# android/unity/README.md documents the path.
apps/wmr_companion_app/android/unity/*/

# Python bytecode from the tool/ tests
__pycache__/

# The pub workspace has one lockfile at the root; members do not keep their own
packages/*/pubspec.lock
example/pubspec.lock
