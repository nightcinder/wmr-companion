<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules. allowBackup="false" already
     turns Auto Backup off; this file also refuses device-to-device transfer,
     which Android 12+ evaluates separately. Every domain is excluded: the
     bridge pairing, connection settings and secure-storage tokens belong to
     the phone that created them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
